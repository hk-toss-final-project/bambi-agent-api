.git
.github
.venv
venv
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 비밀정보 — 절대 이미지에 굽지 않는다 (AGENTS.md 규칙 6)
.env
.env.*
!.env.example

# 개발·문서 자산
docs/
bench/
tests/
logs/
*.md
!README.md

