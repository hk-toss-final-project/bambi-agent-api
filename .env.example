# 애플리케이션 기본 설정
APP_ENV=local
APP_NAME=Report Builder Agent API
APP_VERSION=0.1.0
API_PREFIX=/internal/v1
DOCS_ENABLED=true

# Service API와 Service Worker가 /internal/v1/** 호출에 사용할 공통 Bearer 토큰.
# `openssl rand -hex 32` 등으로 32바이트 이상의 랜덤 값을 생성해 설정한다.
AGENT_INTERNAL_TOKEN=

# MCP 전용 프로세스의 수신 포트와 Claude·ChatGPT·Codex에 등록할 공개 URL.
MCP_SERVER_PORT=8100
MCP_SERVER_URL=http://localhost:8100/mcp
# 401 보호 리소스 Metadata에 표시할 OAuth 발급자 URL.
MCP_AUTH_ISSUER_URL=http://localhost:8080

# 로깅: root 로거 레벨과 회전 파일 로그 디렉터리.
# LOG_DIR을 빈 값으로 두면 파일 로그를 끄고 콘솔(stdout)만 남긴다.
LOG_LEVEL=INFO
LOG_DIR=logs

# 개발 전용 Agent 실행 API(/internal/v1/dev/**) 활성화 여부. APP_ENV가 local 또는 test일 때만 동작한다.
ENABLE_DEV_AGENT_API=false
# /internal/v1/dev/**도 AGENT_INTERNAL_TOKEN Bearer 인증을 동일하게 사용한다.
# /dev 동기 실행 제한 시간(초). 최대 900.
DEV_AGENT_TIMEOUT_SECONDS=180

# Agent DB와 Vector 저장소 연결. Job Queue도 Agent DB의 agent_jobs를 사용한다.
# 주의: Windows에서 localhost는 IPv6(::1)로 먼저 풀려 비동기 psycopg 연결이
# 무한 대기할 수 있으므로 반드시 127.0.0.1을 사용한다.
AGENT_DATABASE_URL=postgresql://bambi_agent:replace-with-local-password@127.0.0.1:5432/bambi_agent
AGENT_DB_NAME=bambi_agent
AGENT_DB_USER=bambi_agent
AGENT_DB_PASSWORD=replace-with-local-password
AGENT_DB_PORT=5432
VECTOR_STORE_URL=postgresql://bambi_agent:replace-with-local-password@127.0.0.1:5432/bambi_agent

# LLM 및 검색 Provider Secret: 실제 값으로 교체하고 .env는 커밋하지 않는다.
OPENAI_API_KEY=replace-with-openai-api-key
TAVILY_API_KEY=replace-with-tavily-api-key

# Personal Wiki Builder 실행 설정
WIKI_LLM_MODEL=gpt-4o-mini
REPORT_LLM_MODEL=gpt-4o-mini
WIKI_EMBEDDING_MODEL=text-embedding-3-small
# 한 번의 Worker 실행이 Claim하는 최대 원본 수 (Wiki Build Batch 크기)
PERSONAL_WIKI_WORKER_BATCH_SIZE=20
# Claim 크기와 별개인 실제 동시 실행 수. DB Connection과 OpenAI 호출도 이 수만큼 실행된다.
PERSONAL_WIKI_JOB_CONCURRENCY=1
REPORT_JOB_CONCURRENCY=1
OPENAI_DEFAULT_RPM=60
OPENAI_DEFAULT_TPM=60000
WIKI_OPENAI_REQUESTS_PER_JOB=8
WIKI_OPENAI_TOKENS_PER_JOB=30000
REPORT_OPENAI_REQUESTS_PER_JOB=12
REPORT_OPENAI_TOKENS_PER_JOB=50000
# 대용량 원본의 LLM 빌드가 10분을 넘을 수 있어 Lease는 여유 있게 잡는다 (최대 3600)
PERSONAL_WIKI_JOB_LEASE_SECONDS=1800
# WIKI_BUILD_QUIET_MINUTES: 마지막 원본 수집 후 이 시간(분) 동안 새 수집이 없으면 Wiki Build를 시작한다.
WIKI_BUILD_QUIET_MINUTES=10
# WIKI_BUILD_MAX_WAIT_MINUTES: 수집이 계속 이어져도 첫 대기 원본 발생 후 이 시간(분) 안에는 Build를 시작한다.
WIKI_BUILD_MAX_WAIT_MINUTES=30
# COLLECTION_SCHEDULER_TICK_SECONDS: Scheduler가 수집 주기 도달 여부를 다시 확인하는 간격(초).
# 실제 수집 주기는 이 값이 아니라 agent.global_sources.schedule_cron이 정한다.
COLLECTION_SCHEDULER_TICK_SECONDS=60
# ENABLE_COLLECTION_SCHEDULER: 서버 기동 시 수집 Scheduler를 함께 띄울지 여부.
# API를 여러 인스턴스로 띄우면 수집이 인스턴스 수만큼 중복 실행되므로,
# 그런 배포에서는 false로 끄고 `python -m scheduler.main`을 한 벌만 띄운다.
ENABLE_COLLECTION_SCHEDULER=true
# COLLECTION_CONTENT_FETCH_LIMIT: Scheduler가 tick마다 Jina Reader로 본문을 채울 문서 수.
# 수집 단계는 URL만 저장하므로 0으로 끄면 본문 없는 문서만 쌓인다.
COLLECTION_CONTENT_FETCH_LIMIT=20
# INTEREST_RECALCULATION_LIMIT: Scheduler가 tick마다 관심사를 다시 계산할 사용자 수(0이면 끔).
# 관심사 점수는 계산 시각 기준으로 최신성을 감쇠시키므로, 0으로 끄면 저장이 멈춘
# 사용자의 점수가 마지막 Wiki Build 시점에 그대로 고정된다.
INTEREST_RECALCULATION_LIMIT=20
# INTEREST_RECALCULATION_STALE_HOURS: 이 시간이 지난 관심사 Profile만 재계산 대상으로 본다.
INTEREST_RECALCULATION_STALE_HOURS=24
# MAINTENANCE_REBUILD_LIMIT: Scheduler가 tick마다 등록할 정기 Wiki 재구성 Job 수(0이면 끔).
# 증분 Build는 원본이 들어올 때만 돌아 누적된 중복·고아 문서를 정리할 기회가 없다.
# 등록만 하고 실제 재구성은 상주 Worker(WORKER-002)가 집어 수행한다.
MAINTENANCE_REBUILD_LIMIT=5
# MAINTENANCE_REBUILD_STALE_HOURS: 사용자별 정기 Wiki 재구성 간격(시간, 기본 7일).
# 재구성은 LLM 재분류 비용이 크므로 관심사 재계산보다 훨씬 드물게 돈다.
MAINTENANCE_REBUILD_STALE_HOURS=168
# GLOBAL_CONTENT_FETCH_CONCURRENCY: 본문을 동시에 내려받을 문서 수(Batch 크기와 별개).
# 위 LIMIT이 20이고 이 값이 5면 5건씩 네 묶음으로 나눠 받는다.
# 외부 Rate Limit(429)에 걸린 문서는 failed로 남아 재시도되지 않으므로 크게 올리지 않는다.
GLOBAL_CONTENT_FETCH_CONCURRENCY=5

# MVP 외부 수집 Provider Secret과 URL
# JINA_API_KEY: Jina Reader(r.jina.ai) 인증 Key. 비워 두면 무인증 무료 호출을 사용한다.
JINA_API_KEY=
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
NEWS_API_KEY=replace-with-news-api-key
GDELT_BASE_URL=https://api.gdeltproject.org
# GDELT_API_KEY: GDELT API 인증 Key. 실제 값으로 교체한다.
GDELT_API_KEY=replace-with-gdelt-api-key

# YOUTUBE_MIN_TRANSCRIPT_CHARS: 본문으로 인정할 YouTube 자막 최소 길이(자).
# 이보다 짧으면 근거로 쓸 내용이 없다고 보고 수집 실패로 남긴다. 영상 길이가
# 아니라 자막 길이로 판정한다 — 영상을 자막으로만 읽기 때문이다. 생략 시 500.
YOUTUBE_MIN_TRANSCRIPT_CHARS=500

# 변경점(Delta) 추적 에이전트
# CHANGE_HISTORY_ENABLED: 변경점 추적 경로를 서버에서 허용할지 여부(운영 차단 스위치).
# 요청 플래그(change_history_enabled)와 별개다 — 요청이 켜서 보내도 이 값이 false면
# 기존 생성 경로로 처리한다. 델타 경로에 장애가 나도 리포트 발행은 멈추면 안 되므로,
# 배포된 상태에서 즉시 되돌릴 스위치를 둔다. 생략 시 켬(1).
CHANGE_HISTORY_ENABLED=1
# CHANGE_HISTORY_IMPACT_MODEL: 파급효과 추론(Impact worker)에만 쓸 모델 이름.
# 이 노드는 추론 난이도가 Overview·타임라인보다 높아 따로 올릴 수 있게 열어 뒀다.
# 비워 두면 나머지 노드와 같은 모델(REPORT_LLM_MODEL)을 쓴다.
CHANGE_HISTORY_IMPACT_MODEL=
# 리포트 생성 검색어 확장
# REPORT_QUERY_EXPANSION_LIMIT: 리포트 생성 시 관심 키워드에 함께 던질 보조 검색어 수.
# 개인 Wiki 그래프에서 그 키워드와 1홉으로 연결된 이웃 노드 제목을 쓴다.
# 온디맨드 리포트가 "고른 주제 하나 + Wiki 연결 상위 태그"를 엮는 경로라 기본 3이다.
# 0으로 두면 확장이 꺼져 이전 동작(검색어 1개)으로 돌아간다.
# 아침 보고서(브리핑)에는 적용되지 않는다 — 리포트 생성 경로 전용이다.
REPORT_QUERY_EXPANSION_LIMIT=3
# SOURCE_COLLECT_CONCURRENCY: 검색어 하나의 소스(뉴스·YouTube·Reddit)를 동시에 부를 수.
# 셋은 서로 다른 서비스라 동시에 불러도 Provider별 요청률이 오르지 않는다.
# 검색어 축은 순차로 남겨 둔다 — 같은 Naver·GDELT에 요청이 몰리는 축이라서다.
# 1로 두면 순차 실행(기존 동작)으로 돌아간다. 생략 시 기본 3.
SOURCE_COLLECT_CONCURRENCY=3
