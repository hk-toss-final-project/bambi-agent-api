# 애플리케이션 기본 설정
APP_ENV=local
APP_NAME=Bambi Agent API
APP_VERSION=0.1.0
API_PREFIX=/internal/v1
DOCS_ENABLED=true

# Agent DB, Vector 저장소, Queue 연결
# 주의: Windows에서 localhost는 IPv6(::1)로 먼저 풀려 비동기 psycopg 연결이
# 무한 대기할 수 있으므로 반드시 127.0.0.1을 사용한다.
AGENT_DATABASE_URL=postgresql://bambi_agent:replace-with-local-password@127.0.0.1:5432/bambi_agent
AGENT_DB_NAME=bambi_agent
AGENT_DB_USER=bambi_agent
AGENT_DB_PASSWORD=replace-with-local-password
AGENT_DB_PORT=5432
# DB 시작 시 아직 적용되지 않은 개발 Seed를 적용할지 여부
AGENT_DB_APPLY_DEV_SEEDS=true
VECTOR_STORE_URL=postgresql://bambi_agent:replace-with-local-password@127.0.0.1:5432/bambi_agent
QUEUE_URL=redis://localhost:6379/0

# LLM 및 검색 Provider Secret: 실제 값으로 교체하고 .env는 커밋하지 않는다.
OPENAI_API_KEY=replace-with-openai-api-key
TAVILY_API_KEY=replace-with-tavily-api-key

# Personal Wiki Builder 실행 설정
WIKI_LLM_MODEL=gpt-4.1-mini
WIKI_EMBEDDING_MODEL=text-embedding-3-small
PERSONAL_WIKI_WORKER_BATCH_SIZE=1
PERSONAL_WIKI_JOB_LEASE_SECONDS=600

# MVP 외부 수집 Provider Secret과 URL
# JINA_API_KEY: Jina Reader(r.jina.ai) 인증 Key. 비워 두면 무인증 무료 호출을 사용한다.
JINA_API_KEY=
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
NEWS_API_KEY=replace-with-news-api-key
GDELT_BASE_URL=https://api.gdeltproject.org
