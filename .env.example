# 애플리케이션 기본 설정
APP_ENV=local
APP_NAME=Bambi Agent API
APP_VERSION=0.1.0
API_PREFIX=/internal/v1
DOCS_ENABLED=true

# Agent DB, Vector 저장소, Queue 연결
AGENT_DATABASE_URL=postgresql://bambi_agent:replace-with-local-password@localhost:5432/bambi_agent
AGENT_DB_NAME=bambi_agent
AGENT_DB_USER=bambi_agent
AGENT_DB_PASSWORD=replace-with-local-password
AGENT_DB_PORT=5432
VECTOR_STORE_URL=postgresql://bambi_agent:replace-with-local-password@localhost:5432/bambi_agent
QUEUE_URL=redis://localhost:6379/0

# LLM 및 검색 Provider Secret: 실제 값으로 교체하고 .env는 커밋하지 않는다.
OPENAI_API_KEY=replace-with-openai-api-key
TAVILY_API_KEY=replace-with-tavily-api-key

# MVP 외부 수집 Provider Secret과 URL
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
NEWS_API_KEY=replace-with-news-api-key
GDELT_BASE_URL=https://api.gdeltproject.org
